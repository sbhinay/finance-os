{
  "name": "finance-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:fixture": "node scripts/validate-finance-export.mjs",
    "validate:properties": "node --no-warnings --experimental-strip-types scripts/validate-property-migration.mjs",
    "validate:debt": "node --no-warnings --experimental-strip-types scripts/validate-debt-reporting.mjs",
    "validate:debt-projection": "node --no-warnings --experimental-strip-types scripts/validate-debt-projection.mjs",
    "validate:scanner": "node --no-warnings --experimental-strip-types scripts/validate-statement-scanner.mjs",
    "validate:scanner:live": "node --no-warnings --experimental-strip-types scripts/validate-live-statement-scanner.mjs",
    "validate:cloud": "node scripts/validate-cloud-guards.mjs",
    "validate:security": "node scripts/validate-security-baseline.mjs",
    "validate:auth": "node scripts/validate-auth-gate.mjs",
    "validate:reports": "node --no-warnings --experimental-strip-types scripts/validate-report-exports.mjs",
    "validate:architecture": "node scripts/validate-canonical-architecture.mjs",
    "validate:import-export": "node scripts/validate-import-export-contract.mjs",
    "validate:mojibake": "node scripts/validate-no-mojibake.mjs",
    "validate:production": "node scripts/validate-production.mjs"
